        "def is_prime(num):\n",
        "    if num<=1:\n",
        "        return False\n",
        "    for i in range(2,int(num**0.5)+1):\n",
        "        if num%i==0:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "for i in range(1,101):\n",
        "    if is_prime(i):\n",
        "        print(i,end=\" \")"
